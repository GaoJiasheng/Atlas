---
/**
 * `<Task id="equivalent-fractions">Try the check</Task>`: a hairline button in
 * a lesson chapter body that opens the chapter's check (a step id: one task
 * drawn from its pool) or one pool task (its id) in the reading panel
 * (SceneHost hands `data-task` to the engine's `goToTask`, the same move as
 * the square tick on the chapter axis). `pnpm validate` checks the id.
 */
import { t } from '../../i18n';
import { pageLocale } from './locale';

interface Props {
  id: string;
}
const { id } = Astro.props;
const locale = pageLocale(Astro.url, Astro.currentLocale);
---
<button type="button" class="atlas-flyto atlas-task-link" data-task={id} title={t(locale, 'math.task.link')}><svg class="atlas-flyto__icon" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><rect x="2" y="2" width="8" height="8" /></svg><span><slot /></span></button>
