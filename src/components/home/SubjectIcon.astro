---
/**
 * Hairline subject icons for the home category tiles and placeholder plates (docs/08 §9).
 * 28-unit grid, 1.25 stroke, round joins, currentColor; `dotted` draws the coming-soon state.
 */
import type { Subject } from '../../content/schema/topic';

interface Props {
  subject: Subject;
  size?: number;
  dotted?: boolean;
  class?: string;
}
const { subject, size = 28, dotted = false, class: className } = Astro.props;
---
<svg
  class:list={['atlas-subject-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 28 28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-dasharray={dotted ? '0.1 2.4' : undefined}
  aria-hidden="true"
  focusable="false"
  data-icon={subject}
>
  {
    subject === 'science' && (
      <>
        <path d="M10.5 3.5h7M12 3.5v7.2L5.6 21.6a1.6 1.6 0 0 0 1.4 2.4h14a1.6 1.6 0 0 0 1.4-2.4L16 10.7V3.5" />
        <path d="M8.4 17h11.2" />
        <circle cx="12.4" cy="20.4" r="1" />
        <circle cx="16.2" cy="19.2" r="0.6" />
      </>
    )
  }
  {
    subject === 'math' && (
      <>
        <rect x="3.5" y="19.5" width="21" height="5" />
        <path d="M6.5 19.5v2M9.5 19.5v1.2M12.5 19.5v2M15.5 19.5v1.2M18.5 19.5v2M21.5 19.5v1.2" />
        <circle cx="14" cy="5" r="1.5" />
        <path d="M14 3.5V2M13.2 6.3 8.5 16.5M14.8 6.3l4.7 10.2M10.6 12h6.8" />
      </>
    )
  }
  {
    subject === 'history' && (
      <>
        <path d="M7 3.5h14M7 24.5h14" />
        <path d="M9 3.5c0 6 5 7.5 5 10.5s-5 4.5-5 10.5M19 3.5c0 6-5 7.5-5 10.5s5 4.5 5 10.5" />
        <path d="M11 24.5c.8-1.8 1.9-2.8 3-3 1.1.2 2.2 1.2 3 3M14 15.5v5.5M11.6 8.2h4.8" />
      </>
    )
  }
  {
    subject === 'geography' && (
      <>
        <circle cx="14" cy="12.5" r="8.5" />
        <ellipse cx="14" cy="12.5" rx="3.6" ry="8.5" />
        <path d="M5.5 12.5h17M6.8 8h14.4M6.8 17h14.4" />
        <path d="M4.2 15.8A10 10 0 0 0 22.6 18.6M14 22.5v2.5M10 25h8" />
      </>
    )
  }
  {
    subject === 'biology' && (
      <>
        <path d="M3.8 24.2C3.8 16 9 10.8 17.2 10.8c0 8.2-5.2 13.4-13.4 13.4z" />
        <path d="M3.8 24.2 13 15M8 20.1h3.8M8 20.1v-3.6M10.8 17.3h3.4M10.8 17.3v-3.2" />
        <ellipse cx="21.3" cy="6.7" rx="1.9" ry="3" transform="rotate(45 21.3 6.7)" />
        <circle cx="23.6" cy="4.4" r="0.9" />
        <path d="M19.6 6.4l-1.8-.6M21.6 8.4l.6 1.8M20.4 5.2 18.9 3.9M22.8 7.6l1.3 1.5" />
      </>
    )
  }
  {
    subject === 'computer' && (
      <>
        <path d="M4 6.5h16.5L24 10v11.5H4z" />
        <path d="M7 9.5h9" />
        <path d="M7.5 13v1.6M10.5 13v1.6M13.5 16.5v1.6M16.5 13v1.6M19.5 16.5v1.6M7.5 18.5v.01M10.5 16.5v1.6M13.5 13v1.6M16.5 18.5v.01M19.5 13v1.6" stroke-width="1.6" />
      </>
    )
  }
</svg>
