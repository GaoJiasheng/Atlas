---
/**
 * One graphite drawing (public/illustrations/<stem>.webp + @2x, scripts/illustrate.ts).
 * Square, transparent; the box is reserved by width/height so nothing shifts on load.
 * Paper multiplies it into the sheet, dark plate inverts it into chalk (global.css `.atlas-drawing`).
 */
import { withBase } from '../../i18n';

interface Props {
  stem: string;
  alt: string;
  /** CSS `sizes`; the browser picks 800 or 1600. */
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { stem, alt, sizes, eager = false, class: className } = Astro.props;
const src = withBase(`/illustrations/${stem}.webp`);
const src2x = withBase(`/illustrations/${stem}@2x.webp`);
---
<img
  class:list={['atlas-drawing', className]}
  src={src}
  srcset={`${src} 800w, ${src2x} 1600w`}
  sizes={sizes}
  width="800"
  height="800"
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  draggable="false"
/>
