---
/**
 * Topic page: loads topic + chapters + engine data at build time and mounts
 * the SceneHost island (small props only; engine data is fetched at runtime). Every chapter's MDX body is rendered for this locale
 * into the island's default slot as `<article data-chapter-body=id>`; the
 * InfoPanel shows the current one (first chapter visible without JS).
 */
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SceneHost from '../../../engines/core/SceneHost';
import LangEn from '../../../components/mdx/LangEn.astro';
import LangZh from '../../../components/mdx/LangZh.astro';
import More from '../../../components/mdx/More.astro';
import Num from '../../../components/mdx/Num.astro';
import FlyTo from '../../../components/mdx/FlyTo.astro';
import Term from '../../../components/mdx/Term.astro';
import Frac from '../../../components/mdx/Frac.astro';
import Task from '../../../components/mdx/Task.astro';
import { LOCALES, localeHref, tx, withBase, type Locale } from '../../../i18n';
import { chapterThemeMap, getTopicChapters, getTopics, topicEngineData, type TopicEntry } from '../../../lib/content';

export async function getStaticPaths() {
  const topics = await getTopics();
  return LOCALES.flatMap((locale) => topics.map((topic) => ({ params: { locale, slug: topic.id }, props: { topic } })));
}

interface Props {
  topic: TopicEntry;
}

const { topic } = Astro.props;
const locale = Astro.params.locale as Locale;

const chapterEntries = await getTopicChapters(topic.id);
const chapters = chapterEntries.map((entry) => entry.data);
const bodies = await Promise.all(chapterEntries.map((entry) => render(entry)));
// Engine data is validated here (a bad data file fails the page build) but NOT embedded in the
// island props: it is written once per topic to /topics/<slug>/data.json (src/pages/topics) and the
// SceneHost fetches it on the client.
topicEngineData(topic);
// (`trailingSlash: 'always'`: the dev server only routes the endpoint with a trailing slash; the
// built file is dist/topics/<slug>/data.json.)
const dataUrl = withBase(`/topics/${topic.id}/data.json`) + (import.meta.env.DEV ? '/' : '');

// MDX components chapter bodies use without imports.
const components = { Lang: locale === 'zh' ? LangZh : LangEn, More, Num, FlyTo, Term, Frac, Task };
---
<BaseLayout
  locale={locale}
  title={tx(topic.data.title, locale)}
  description={tx(topic.data.subtitle, locale)}
  themeDefault={topic.data.theme}
  chapterThemes={chapterThemeMap(chapters)}
>
  <SceneHost
    client:visible
    topic={topic.data}
    chapters={chapters}
    dataUrl={dataUrl}
    locale={locale}
    path={Astro.url.pathname}
    indexHref={localeHref(locale, '/')}
  >
    {
      bodies.map(({ Content }, index) => (
        <article data-chapter-body={chapters[index]?.id} hidden={index !== 0}>
          <Content components={components} />
        </article>
      ))
    }
  </SceneHost>
</BaseLayout>
