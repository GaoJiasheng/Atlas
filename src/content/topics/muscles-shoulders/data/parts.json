      "name": {
        "en": "Clavicle",
        "zh": "锁骨"
      },
      "short": {
        "en": "Clavicle",
        "zh": "锁骨"
      },
      "summary": {
        "en": "The collarbone supports the shoulder away from the chest.",
        "zh": "锁骨把肩部撑离胸廓。"
      },
      "detail": {
        "en": "Its lateral third gives the front deltoid its origin; the upper trapezius attaches along its posterior border. The medial end meets the sternum [M1] [M48].",
        "zh": "外侧三分之一是三角肌前部的起点；上斜方肌止于它的后缘。内侧端连胸骨 [M1] [M48]。"
      },
      "material": {
        "color": "tissue",
        "tint": "token:bone"
      },
      "connects": []
    },
    {
      "id": "scapula",
