        "rotate": {
          "axis": [
            0,
            0,
            1
          ],
          "per": -1,
          "pivot": [
            -0.25,
            1,
            0
          ]
        }
      },
      {
        "output": "flow-state",
        "flow": "section-air",
        "airfoilFlow": true
      },
      {
        "control": "flow-view",
        "flow": "section-air",
        "visible": {
          "eq": "streamlines"
        }
      }
    ],
    "overlays": [
      {
        "kind": "force-vectors",
        "group": "flight-flows",
        "per": 0.00015,
        "max": 0.5,
        "arrows": [
          {
            "part": "foil-sample",
            "force": "lift",
            "dir": [
              0,
              1,
              0
            ],
            "value": {
              "output": "lift-n"
            }
          }
        ]
      },
      {
        "kind": "force-vectors",
        "group": "flight-flows",
        "per": 0.0004,
        "max": 0.55,
        "arrows": [
          {
            "part": "force-body",
            "force": "gravity",
            "dir": [
              0,
              -1,
              0
            ],
            "value": 1000,
            "when": {
              "control": "diagram-case",
              "is": {
                "in": [
                  "vertical",
                  "level",
                  "bank",
                  "weight"
                ]
              }
            }
          },
          {
            "part": "force-body",
            "force": "lift",
            "dir": [
              0,
              1,
              0
            ],
            "value": 1000,
            "when": {
              "control": "diagram-case",
              "is": {
                "in": [
                  "vertical",
                  "level"
                ]
              }
            }
          },
          {
            "part": "force-body",
            "force": "thrust",
            "dir": [
              -1,
              0,
              0
            ],
            "value": 100,
            "when": {
              "control": "diagram-case",
              "is": {
                "in": [
                  "level",
                  "axial"
                ]
              }
            }
          },
          {
            "part": "force-body",
            "force": "drag",
            "dir": [
              1,
              0,
              0
            ],
            "value": 100,
            "when": {
              "control": "diagram-case",
              "is": {
                "in": [
                  "level",
                  "axial"
                ]
              }
            }
          },
          {
            "part": "force-body",
            "force": "lift",
            "dir": [
              0,
              0.9396926207859084,
              -0.3420201433256687
            ],
            "value": 1000,
            "when": {
              "control": "diagram-case",
              "is": {
                "in": [
                  "bank"
                ]
              }
            }
          }
        ]
      },
      {
        "kind": "airfoil-pressure",
        "part": "foil-sample",
        "group": "flight-flows",
        "when": {
          "control": "flow-view",
          "is": {
            "eq": "pressure"
          }
        }
      }
    ]
  }
