    {
      "id": "drop-stand",
      "name": {
        "en": "Drop tower",
        "zh": "落体架"
      },
      "group": "drop",
      "summary": {
        "en": "Holds things at a set height above the sand.",
        "zh": "把物体固定在沙面上方一定高度。"
      },
      "detail": {
        "en": "An upright rod 1.6 m tall on a heavy base, standing on the floor beside the bench, with marks at 0.5, 1.0 and 1.5 m above the sand [S1].\n\nNever drop things from a height where someone could be below [S28].",
