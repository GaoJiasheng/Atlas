# Cloudflare Pages headers (copied to dist/_headers by the build).
# Rules are additive: a path gets every matching block.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Hashed build output: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Basemaps and models are not content-hashed: one week.
/geo/*
  Cache-Control: public, max-age=604800
/models/*
  Cache-Control: public, max-age=604800

# The service worker and manifest must always revalidate so updates roll out.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
