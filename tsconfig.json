{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "tests/**/*", "tests-e2e/**/*", "astro.config.mjs", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["dist", "node_modules", "scripts/anatomy/cache"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  }
}
